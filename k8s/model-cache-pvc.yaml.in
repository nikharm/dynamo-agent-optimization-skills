apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: @@MODEL_CACHE_PVC@@
  labels:
    app.kubernetes.io/part-of: dynamo-toolagent-optimization
spec:
  accessModes:
    - ReadWriteMany
  storageClassName: @@MODEL_CACHE_STORAGE_CLASS@@
  resources:
    requests:
      storage: @@MODEL_CACHE_SIZE@@
