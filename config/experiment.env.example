# Copy this file to config/experiment.env and replace every REPLACE_ME value.

KUBE_CONTEXT=REPLACE_ME
NAMESPACE=dynamo-toolagent
DGD_NAME=toolagent-qwen32b

DYNAMO_IMAGE=nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.4.1
MODEL_ID=Qwen/Qwen3-32B
MODEL_REVISION=9216db5781bf21249d130ec9da846c4624c16137
TOKENIZER_PATH=/root/.cache/huggingface/hub/models--Qwen--Qwen3-32B/snapshots/9216db5781bf21249d130ec9da846c4624c16137
MODEL_SECRET_NAME=model-access
MODEL_CACHE_PVC=model-cache
MODEL_CACHE_STORAGE_CLASS=REPLACE_ME
MODEL_CACHE_SIZE=200Gi
HF_HUB_OFFLINE=1

# Set these to a label shared by the H100 worker nodes.
GPU_NODE_LABEL_KEY=REPLACE_ME
GPU_NODE_LABEL_VALUE=REPLACE_ME
WORKER_REPLICAS=8

# The benchmark client is CPU-only. Select a non-GPU node pool when possible.
BENCH_NODE_LABEL_KEY=kubernetes.io/os
BENCH_NODE_LABEL_VALUE=linux
BENCH_IMAGE=python:3.12-slim

AIPERF_VERSION=0.10.0
REQUEST_COUNT=5775
TTFT_THRESHOLD_MS=5000
ITL_THRESHOLD_MS=100
GPU_COUNT=8
